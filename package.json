{
  "name": "shanhe-story-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,blue \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "desktop": "npm run desktop:pack && node scripts/open-macos.mjs",
    "desktop:pack": "npm run icons && npm run build && node scripts/build-macos.mjs",
    "format": "prettier --write src server shared tests scripts *.json vite.config.ts index.html",
    "icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^5.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/express": "^5.0.5",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  },
  "description": "山河 — 地图、时间线与 AI 共创的本地故事工作台",
  "author": "Shanhe",
  "license": "UNLICENSED"
}
